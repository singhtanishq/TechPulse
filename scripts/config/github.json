{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechPulse GitHub Configuration",
  "description": "Configuration for GitHub repositories tracked by TechPulse.",
  "type": "object",
  "required": [
    "tracked_repositories",
    "collection"
  ],
  "properties": {
    "tracked_repositories": {
      "type": "array",
      "description": "Public GitHub repositories whose metadata and stable releases are collected.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "owner",
          "repo",
          "category"
        ],
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "include_prereleases",
        "include_drafts",
        "max_releases_per_repo",
        "rate_limit_delay_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "include_prereleases": {
          "type": "boolean",
          "const": false,
          "description": "TechPulse intentionally excludes prereleases from the stable release signal."
        },
        "include_drafts": {
          "type": "boolean",
          "const": false,
          "description": "TechPulse intentionally excludes draft releases."
        },
        "max_releases_per_repo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rate_limit_delay_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        }
      }
    }
  },
  "tracked_repositories": [
    {
      "owner": "facebook",
      "repo": "react",
      "category": "frontend"
    },
    {
      "owner": "laravel",
      "repo": "framework",
      "category": "backend"
    },
    {
      "owner": "nodejs",
      "repo": "node",
      "category": "runtime"
    },
    {
      "owner": "python",
      "repo": "cpython",
      "category": "runtime"
    },
    {
      "owner": "vitejs",
      "repo": "vite",
      "category": "build-tool"
    },
    {
      "owner": "vuejs",
      "repo": "core",
      "category": "frontend"
    },
    {
      "owner": "django",
      "repo": "django",
      "category": "backend"
    },
    {
      "owner": "rust-lang",
      "repo": "rust",
      "category": "language"
    },
    {
      "owner": "golang",
      "repo": "go",
      "category": "language"
    },
    {
      "owner": "tensorflow",
      "repo": "tensorflow",
      "category": "ml"
    },
    {
      "owner": "pytorch",
      "repo": "pytorch",
      "category": "ml"
    },
    {
      "owner": "kubernetes",
      "repo": "kubernetes",
      "category": "infrastructure"
    },
    {
      "owner": "hashicorp",
      "repo": "terraform",
      "category": "infrastructure"
    },
    {
      "owner": "docker",
      "repo": "cli",
      "category": "infrastructure"
    },
    {
      "owner": "vercel",
      "repo": "next.js",
      "category": "frontend"
    },
    {
      "owner": "tailwindlabs",
      "repo": "tailwindcss",
      "category": "css-framework"
    },
    {
      "owner": "prisma",
      "repo": "prisma",
      "category": "database"
    },
    {
      "owner": "supabase",
      "repo": "supabase",
      "category": "backend"
    },
    {
      "owner": "anthropics",
      "repo": "anthropic-sdk-python",
      "category": "ai"
    },
    {
      "owner": "openai",
      "repo": "openai-python",
      "category": "ai"
    }
  ],
  "collection": {
    "include_prereleases": false,
    "include_drafts": false,
    "max_releases_per_repo": 5,
    "rate_limit_delay_seconds": 1
  }
}
